# ─── Database ───────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=calm_stories
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5433/calm_stories

# ─── JWT Auth ───────────────────────────────
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d

# ─── Supabase Storage ──────────────────────
SUPABASE_URL=https://your-project.supabase.co/storage/v1/s3
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_BUCKET=story-assets

# ─── RevenueCat ─────────────────────────────
# Same value must be set as the Authorization header in the RevenueCat
# dashboard webhook settings (Integrations → Webhooks).
REVENUECAT_WEBHOOK_SECRET=change-this-to-a-long-random-string

# ─── Email (SMTP) ───────────────────────────
# Sends password-reset codes and email-verification links. Plain SMTP via
# nodemailer, so any provider works.
#
# DEV: Mailtrap Sandbox — captures all mail in a web inbox and delivers to
# NOBODY, so test registrations can never reach a real person. Credentials:
# Mailtrap → Email Testing → your inbox → SMTP Settings → Nodemailer.
#
# Leave SMTP_USER/PASS blank to fall back to the console stub (messages are
# printed to the API server log); email verification then reports itself as
# unenforceable and the app gates nothing on it.
#
# The API refuses to boot with a sandbox host when NODE_ENV=production, so this
# cannot reach production by accident. For the production values see
# ARCHITECTURE_REVIEW.md → "Email delivery — production migration".
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-mailtrap-inbox-username
SMTP_PASS=your-mailtrap-inbox-password
SMTP_FROM=Little World <no-reply@littleworld.app>

# ─── Public URL (email links) ───────────────
# Base URL that emailed verification links point at. Must be reachable from
# wherever the parent opens their mail, NOT from the server — in production
# this is the deployed API origin. The API refuses to boot in production if
# this points at localhost, because every link would be dead on arrival.
APP_PUBLIC_URL=http://localhost:3000

# ─── API ────────────────────────────────────
API_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# ─── Admin web panel ────────────────────────
# The admin app reads its own env file, NOT this one. Its variables
# (NEXT_PUBLIC_API_URL, SESSION_COOKIE_NAME) live in apps/admin/.env.local —
# copy apps/admin/.env.local.example to get started.
